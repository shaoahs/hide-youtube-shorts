{
  "manifest_version": 3,
  "name": "Hide YouTube Shorts",
  "version": "1.0",
  "description": "隱藏 YouTube 上所有短影音（Shorts）相關元素，包含側邊欄連結、首頁區塊、搜尋結果與影片卡片。",
  "author": "dott",
  "homepage_url": "https://github.com/shaoahs/hide-youtube-shorts",
  "browser_specific_settings": {
    "gecko": {
      "id": "hide-youtube-shorts@black",
      "strict_min_version": "57.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
